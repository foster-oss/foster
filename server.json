{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.foster-oss/foster",
  "title": "Foster",
  "description": "Check installs for malware, hallucinated or abandoned packages before an agent runs them.",
  "version": "0.9.1",
  "websiteUrl": "https://foster-oss.github.io/foster/",
  "repository": {
    "url": "https://github.com/foster-oss/foster",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/foster-oss/foster/main/brand/logo-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "foster-oss",
      "version": "0.9.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
